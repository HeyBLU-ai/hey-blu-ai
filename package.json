{
  "name": "hey-blu-ai",
  "version": "1.0.0",
  "type": "module",
  "main": "api/ask.js",
  "scripts": {
    "start": "node api/ask.js",
    "build": "tsc",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "vercel-build": "npm run build && npm run build:css",
    "dev": "node -e \"console.log('vercel dev is running — open http://localhost:3000/rulebook'); process.stdin.resume()\"",
    "verify:models": "node scripts/verify-models.mjs",
    "smoke:ask-v2": "node scripts/smoke-ask-v2.mjs",
    "test:ingest:skeleton": "node scripts/test-ingest-skeleton.mjs",
    "test:ingest:pdf": "node scripts/test-parse-pdf.mjs",
    "test:ingest:docx": "node scripts/test-parse-docx.mjs",
    "test:ingest:url": "node scripts/test-parse-url.mjs",
    "test:ingest:warnings": "node scripts/test-parse-warnings.mjs",
    "test:ingest:spans": "node scripts/test-create-spans.mjs",
    "test:ingest:atoms": "node scripts/test-extract-atoms.mjs",
    "test:ingest:coverage": "node scripts/test-verify-coverage.mjs",
    "test:ingest:version": "node scripts/test-write-version.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@llamaindex/llama-cloud": "^2.8.0",
    "dotenv": "^17.1.0",
    "jsonrepair": "^3.14.0",
    "mammoth": "^1.12.0",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "@vercel/node": "^5.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "vercel": "^44.3.0"
  }
}
