{
  "version": 2,
  "builds": [
    {
      "src": "api/ask.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["api/data/**"]
      }
    },
    { 
      "src": "api/shorten.ts", 
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["api/data/**"]
      }
    },
    { 
      "src": "api/retrieve.ts", 
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["api/data/**"]
      }
    },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "service-worker.js", "use": "@vercel/static" },
        { "src": "dist/output.css", "use": "@vercel/static" },
        { "src": "public/output.css", "use": "@vercel/static" },
    { "src": "rulebook/index.html", "use": "@vercel/static" },
    { "src": "rulebook/share.html", "use": "@vercel/static" },
    { "src": "rulebook/legal.html", "use": "@vercel/static" },
    { "src": "rulebook/manifest.json", "use": "@vercel/static" },
    { "src": "rulebook/service-worker.js", "use": "@vercel/static" },
    { "src": "pitchdeck/index.html", "use": "@vercel/static" },
    { "src": "pitchdeck2/index.html", "use": "@vercel/static" },
    { "src": "pitchdeck3/index.html", "use": "@vercel/static" },
    { "src": "pitchdeck4/index.html", "use": "@vercel/static" },
    { "src": "pitchdeck5/index.html", "use": "@vercel/static" },
    { "src": "pitchdeck6/index.html", "use": "@vercel/static" },
    { "src": "pitchdeck7/index.html", "use": "@vercel/static" },
    { "src": "pitchdeck8/index.html", "use": "@vercel/static" },
    { "src": "market/index.html", "use": "@vercel/static" },
    { "src": "revenuesprint/index.html", "use": "@vercel/static" },
    { "src": "use-of-funds/index.html", "use": "@vercel/static" },
    { "src": "privacy/index.html", "use": "@vercel/static" },
    { "src": "terms/index.html", "use": "@vercel/static" },
    { "src": "support/index.html", "use": "@vercel/static" },
    { "src": "about/index.html", "use": "@vercel/static" },
    { "src": "zone/index.html", "use": "@vercel/static" },
    { "src": "faq/index.html", "use": "@vercel/static" },
    { "src": "own/index.html", "use": "@vercel/static" },
    { "src": "survey/index.html", "use": "@vercel/static" },
    { "src": "betablu/index.html", "use": "@vercel/static" },
    { "src": "betablu/**", "use": "@vercel/static" },
    { "src": "pitchdeck/assets/**", "use": "@vercel/static" },
    { "src": "pitchdeck/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck2/assets/**", "use": "@vercel/static" },
    { "src": "pitchdeck2/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck3/assets/**", "use": "@vercel/static" },
    { "src": "pitchdeck3/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck4/assets/**", "use": "@vercel/static" },
    { "src": "pitchdeck4/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck5/assets/**", "use": "@vercel/static" },
    { "src": "pitchdeck5/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck5/videos/**", "use": "@vercel/static" },
    { "src": "pitchdeck6/assets/**", "use": "@vercel/static" },
    { "src": "pitchdeck6/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck6/videos/**", "use": "@vercel/static" },
    { "src": "pitchdeck7/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck7/videos/**", "use": "@vercel/static" },
    { "src": "pitchdeck8/images/**", "use": "@vercel/static" },
    { "src": "pitchdeck8/videos/**", "use": "@vercel/static" },
    { "src": "use-of-funds/**", "use": "@vercel/static" },
    { "src": "vision/index.html", "use": "@vercel/static" },
    { "src": "thank-you.html", "use": "@vercel/static" },
    { "src": "docs/setup/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ask", "dest": "api/ask.js" },
    { "src": "/api/shorten", "dest": "api/shorten.ts" },
    { "src": "/r/(?<slug>[^/]+)", "dest": "/api/retrieve.ts?slug=$slug" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/service-worker.js", "dest": "/service-worker.js" },
        { "src": "/dist/output.css", "dest": "/dist/output.css" },
        { "src": "/public/output.css", "dest": "/public/output.css" },
    { "src": "/rulebook/share.html", "dest": "/rulebook/share.html" },
    { "src": "/rulebook/legal.html", "dest": "/rulebook/legal.html" },
    { "src": "/rulebook/manifest.json", "dest": "/rulebook/manifest.json" },
    { "src": "/rulebook/service-worker.js", "dest": "/rulebook/service-worker.js" },
    { "src": "/rulebook", "dest": "/rulebook/index.html" },
    { "src": "/pitchdeck", "dest": "/pitchdeck/index.html" },
    { "src": "/pitchdeck2", "dest": "/pitchdeck2/index.html" },
    { "src": "/pitchdeck3", "dest": "/pitchdeck3/index.html" },
    { "src": "/pitchdeck4", "dest": "/pitchdeck4/index.html" },
    { "src": "/pitchdeck5", "dest": "/pitchdeck5/index.html" },
    { "src": "/pitchdeck6", "dest": "/pitchdeck6/index.html" },
    { "src": "/pitchdeck7", "dest": "/pitchdeck7/index.html" },
    { "src": "/pitchdeck8", "dest": "/pitchdeck8/index.html" },
    { "src": "/market", "dest": "/market/index.html" },
    { "src": "/revenuesprint", "dest": "/revenuesprint/index.html" },
    { "src": "/use-of-funds", "dest": "/use-of-funds/index.html" },
    { "src": "/use-of-funds/", "dest": "/use-of-funds/index.html" },
    { "src": "/use-of-funds/(.*)", "dest": "/use-of-funds/$1" },
    { "src": "/privacy", "dest": "/privacy/index.html" },
    { "src": "/privacy/", "dest": "/privacy/index.html" },
    { "src": "/privacy/(.*)", "dest": "/privacy/$1" },
    { "src": "/terms", "dest": "/terms/index.html" },
    { "src": "/terms/", "dest": "/terms/index.html" },
    { "src": "/terms/(.*)", "dest": "/terms/$1" },
    { "src": "/support", "dest": "/support/index.html" },
    { "src": "/support/", "dest": "/support/index.html" },
    { "src": "/support/(.*)", "dest": "/support/$1" },
    { "src": "/about", "dest": "/about/index.html" },
    { "src": "/about/", "dest": "/about/index.html" },
    { "src": "/about/(.*)", "dest": "/about/$1" },
    { "src": "/zone", "dest": "/zone/index.html" },
    { "src": "/zone/", "dest": "/zone/index.html" },
    { "src": "/zone/(.*)", "dest": "/zone/$1" },
    { "src": "/faq", "dest": "/faq/index.html" },
    { "src": "/faq/", "dest": "/faq/index.html" },
    { "src": "/faq/(.*)", "dest": "/faq/$1" },
    { "src": "/own", "dest": "/own/index.html" },
    { "src": "/own/", "dest": "/own/index.html" },
    { "src": "/own/(.*)", "dest": "/own/$1" },
    { "src": "/survey", "dest": "/survey/index.html" },
    { "src": "/survey/", "dest": "/survey/index.html" },
    { "src": "/survey/(.*)", "dest": "/survey/$1" },
    { "src": "/betablu", "dest": "/betablu/index.html" },
    { "src": "/betablu/", "dest": "/betablu/index.html" },
    { "src": "/betablu/(.*)", "dest": "/betablu/$1" },
    { "src": "/docs/setup/(.*)", "dest": "/docs/setup/$1" },
    { "src": "/pitchdeck/(.*)", "dest": "/pitchdeck/$1" },
    { "src": "/pitchdeck2/(.*)", "dest": "/pitchdeck2/$1" },
    { "src": "/pitchdeck3/(.*)", "dest": "/pitchdeck3/$1" },
    { "src": "/pitchdeck4/(.*)", "dest": "/pitchdeck4/$1" },
    { "src": "/pitchdeck5/(.*)", "dest": "/pitchdeck5/$1" },
    { "src": "/pitchdeck6/(.*)", "dest": "/pitchdeck6/$1" },
    { "src": "/pitchdeck7/(.*)", "dest": "/pitchdeck7/$1" },
    { "src": "/pitchdeck8/(.*)", "dest": "/pitchdeck8/$1" },
    { "src": "/market/(.*)", "dest": "/market/$1" },
    { "src": "/revenuesprint/(.*)", "dest": "/revenuesprint/$1" },
    { "src": "/vision", "dest": "/vision/index.html" },
    { "src": "/thank-you", "dest": "/thank-you.html" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/", "dest": "/index.html" }
  ]
}